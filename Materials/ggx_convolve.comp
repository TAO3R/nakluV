#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube ENV_MAP;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D OUT_FACE;

layout(push_constant) uniform Params {
	float roughness;
	int face;
	int output_size;
	int num_samples;
};

const float PI = 3.14159265358979323846;

float radical_inverse_vdc(uint bits) {
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint N) {
	return vec2(float(i) / float(N), radical_inverse_vdc(i));
}

vec3 importance_sample_ggx(vec2 xi, vec3 N, float a2) {
	float phi = 2.0 * PI * xi.x;
	float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a2 - 1.0) * xi.y));
	float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

	vec3 H = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);

	vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 T = normalize(cross(up, N));
	vec3 B = cross(N, T);

	return normalize(T * H.x + B * H.y + N * H.z);
}

vec3 direction_from_face_uv(int f, float u, float v) {
	float s = 2.0 * u - 1.0;
	float t = 2.0 * v - 1.0;
	switch (f) {
		case 0: return normalize(vec3( 1.0,    t,   -s));
		case 1: return normalize(vec3(-1.0,    t,    s));
		case 2: return normalize(vec3(    s, 1.0,   -t));
		case 3: return normalize(vec3(    s,-1.0,    t));
		case 4: return normalize(vec3(    s,    t, 1.0));
		case 5: return normalize(vec3(   -s,    t,-1.0));
		default: return vec3(0.0);
	}
}

void main() {
	ivec2 px = ivec2(gl_GlobalInvocationID.xy);
	if (px.x >= output_size || px.y >= output_size) return;

	float u = (float(px.x) + 0.5) / float(output_size);
	float v = (float(px.y) + 0.5) / float(output_size);

	vec3 N = direction_from_face_uv(face, u, v);
	vec3 R = N;
	vec3 V = R;

	float a = roughness * roughness;
	float a2 = a * a;

	vec3 color = vec3(0.0);
	float weight = 0.0;
	uint S = uint(num_samples);

	for (uint i = 0u; i < S; ++i) {
		vec2 xi = hammersley(i, S);
		vec3 H = importance_sample_ggx(xi, N, a2);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);

		float NdotL = max(dot(N, L), 0.0);
		if (NdotL > 0.0) {
			color += texture(ENV_MAP, L).rgb * NdotL;
			weight += NdotL;
		}
	}

	color /= max(weight, 0.001);
	imageStore(OUT_FACE, px, vec4(color, 1.0));
}
